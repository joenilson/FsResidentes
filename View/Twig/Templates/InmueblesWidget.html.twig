<div class="card shadow-sm">
    <div class="card-header">
        <i class="fa-solid fa-door-open me-2" aria-hidden="true"></i>
        {{ fsc.inmuebles | length }} Inmuebles
    </div>
    <div class="card-body">
        {% if fsc.inmuebles is not empty %}
            <div class="row g-6">
                {% for inmueble in fsc.inmuebles %}
                    <div class="col-12 col-md-12 col-xl-12">
                        <div class="card shadow-sm border-0 rounded-3 h-100">
                            <div class="card-header bg-white border-bottom-0 pt-3 pb-0 d-flex justify-content-between align-items-start">
                                <div>
                                    <h5 class="card-title fw-bold text-primary mb-1">
                                        <i class="fa-solid {% if inmueble.ocupado %}text-danger fa-door-closed{% else %}text-success fa-door-open{% endif %} me-2"></i>{{ inmueble.numero }}
                                    </h5>
                                    <small class="text-muted">Nº {{ inmueble.numero }}</small>
                                </div>
                                {% if inmueble.ocupado %}
                                    <span class="badge bg-danger">Ocupado</span>
                                {% else %}
                                    <span class="badge bg-success">Disponible</span>
                                {% endif %}
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        {% if inmueble.codcliente %}
                                            <div class="small text-muted">Residente: {{ inmueble.getResidente().nombre }}</div>
                                        {% else %}
                                            <div class="small text-muted">Sin residente asignado</div>
                                        {% endif %}
                                        {% if inmueble.ubicacion %}
                                            <div class="small text-muted">Ubicación: {{ inmueble.ubicacion }}</div>
                                        {% endif %}
                                    </div>
                                    <div>
                                        {% if inmueble.codcliente %}
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-quitar-residente" data-id-inmueble="{{ inmueble.id }}">
                                                <i class="fa-solid fa-user-minus"></i>
                                            </button>
                                        {% else %}
                                            <button type="button" class="btn btn-sm btn-outline-primary btn-agregar-residente" 
                                                    data-id-inmueble="{{ inmueble.id }}"
                                                    data-codigo-externo="{{ inmueble.codigoExterno() }}"
                                                    data-numero="{{ inmueble.numero }}">
                                                <i class="fa-solid fa-user-plus"></i>
                                            </button>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-muted">No hay inmuebles disponibles para esta edificación.</div>
        {% endif %}
    </div>
</div>